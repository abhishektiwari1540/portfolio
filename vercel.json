{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.abhishektiwari.online"
        }
      ],
      "destination": "https://abhishektiwari.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://abhishektiwari.online/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/revalidate",
      "destination": "/api/revalidate.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
